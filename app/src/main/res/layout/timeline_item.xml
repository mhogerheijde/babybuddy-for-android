<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <ImageButton
        android:id="@+id/removeButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        android:background="#FF5555"
        android:baselineAlignBottom="false"
        android:padding="4dp"
        android:src="@android:drawable/ic_menu_delete"
        app:layout_constraintBottom_toBottomOf="@+id/viewGroup"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/viewGroup"
        app:layout_constraintTop_toTopOf="@+id/viewGroup" />

    <LinearLayout
        android:id="@+id/viewGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:padding="4dp"
        app:layout_constraintEnd_toStartOf="@+id/removeButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/defaultView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/genericType"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:gravity="center"
                android:height="48dp"
                android:text="T"
                tools:ignore="HardcodedText" />

            <include
                android:id="@+id/genericDetails"
                layout="@layout/timeline_item_details"
                />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/noteTimeView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="0"
            android:gravity="top"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:background="@color/notes_enabled"
                android:minHeight="48dp"
                android:minWidth="48dp"
                android:padding="4dp"
                app:srcCompat="@drawable/pkg_notes"
                app:tint="@color/fixed_color_button_text_color"
                app:tintMode="src_in" />

            <include
                android:id="@+id/noteDetails"
                layout="@layout/timeline_item_details"
                />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/pumpingTimeView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="0"
            android:gravity="top"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:background="@color/pumping_enabled"
                android:minHeight="48dp"
                android:minWidth="48dp"
                android:padding="4dp"
                app:srcCompat="@drawable/pkg_pumping"
                app:tint="@color/fixed_color_button_text_color"
                app:tintMode="src_in" />

            <include
                android:id="@+id/pumpingDetails"
                layout="@layout/timeline_item_details"
                />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/tummyTimeView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="0"
            android:gravity="top"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:background="@color/tummy_time_enabled"
                android:minHeight="48dp"
                android:minWidth="48dp"
                android:padding="4dp"
                app:srcCompat="@drawable/pkg_crawl"
                app:tint="@color/fixed_color_button_text_color"
                app:tintMode="src_in" />

            <include
                android:id="@+id/tummy_time_details"
                layout="@layout/timeline_item_details"
                />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/diaperView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="0"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:background="@color/diaper_enabled"
                android:minHeight="48dp"
                android:minWidth="48dp"
                android:padding="4dp"
                app:srcCompat="@drawable/pkg_diaper"
                app:tint="@color/fixed_color_button_text_color"
                app:tintMode="src_in" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                >
                <TextView
                    android:id="@+id/diaperDateTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:text="01/01/1900 11:11 - 22:22 (11h 11m)"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:paddingBottom="0dp"
                    android:layout_marginBottom="0dp"
                    android:textSize="13sp"
                    tools:ignore="HardcodedText" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    >

                    <ImageView
                        android:id="@+id/diaperWetImage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="0"
                        android:minHeight="16dp"
                        android:minWidth="16dp"
                        android:padding="4dp"
                        app:srcCompat="@drawable/pkg_wet"
                        app:tint="?android:attr/textColorSecondary"
                        app:tintMode="src_in" />

                    <ImageView
                        android:id="@+id/diaperSolidImage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="0"
                        android:minHeight="16dp"
                        android:minWidth="16dp"
                        android:padding="4dp"
                        app:srcCompat="@drawable/pkg_poop"
                        app:tint="?android:attr/textColorSecondary"
                        app:tintMode="src_in" />

                    <TextView
                        android:id="@+id/diaperText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:textSize="13sp"
                        android:text="TextView" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sleepView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="0"
            android:gravity="top"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/sleep_enabled"
                android:contentDescription="@string/sleep_icon_description"
                android:minHeight="48dp"
                android:minWidth="48dp"
                android:padding="4dp"
                app:srcCompat="@drawable/pkg_sleep"
                app:tint="@color/fixed_color_button_text_color"
                app:tintMode="src_in" />

            <include
                android:id="@+id/sleepTimeDetails"
                layout="@layout/timeline_item_details"
                />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/feedingView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="0"
            android:gravity="top"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/feedingBreastImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:background="@color/feeding_enabled"
                android:minHeight="48dp"
                android:minWidth="48dp"
                android:padding="4dp"
                app:srcCompat="@drawable/pkg_breast"
                app:tint="@color/fixed_color_button_text_color"
                app:tintMode="src_in" />

            <include
                android:id="@+id/feedingDetails"
                layout="@layout/timeline_item_details"
                />
        </LinearLayout>
    </LinearLayout>

    <eu.pkgsoftware.babybuddywidgets.widgets.LongClickBackgroundBubble
        android:id="@+id/longclickBubble"
        style="@style/LongClickBubble"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:translationZ="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>